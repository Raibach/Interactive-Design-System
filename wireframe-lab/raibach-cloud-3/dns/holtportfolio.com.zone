; holtportfolio.com — BIND zone file, ready to import into Hetzner Console → DNS.
; Generated 2026-10-11 from the LIVE zone, verified record-by-record against
; SiteGround's authoritative name servers (ns1/ns2.siteground.net). The wildcard
; row was verified with a random test name (it answered the box).
;
; RULES (same as raibach.net.zone):
;   - DO NOT copy the old NS rows (ns1/ns2.siteground.net). Hetzner creates its
;     own three name servers automatically; delete the old NS rows if present.
;   - Names WITHOUT a trailing dot get the zone appended (www → www.holtportfolio.com).
;     Names WITH a trailing dot are taken as full (used in MX/CNAME targets).
;
$ORIGIN holtportfolio.com.
$TTL 3600

; ── web ─────────────────────────────────────────────────────────────────────
@			IN	A	188.245.25.26	; the box — Caddy redirects apex → john
www			IN	A	188.245.25.26	; redirects → john
john			IN	A	188.245.25.26	; THE site — WordPress served here by Caddy
www.john		IN	A	188.245.25.26	; redirects → john
*			IN	A	188.245.25.26	; wildcard — any other name reaches the box

; ── legacy rows still pointing at the old host (SiteGround) ────────────────
; Copied as-is so the switch changes nothing. Retire or repoint deliberately
; later — never as a side effect of the move.
autodiscover	IN	A	35.212.127.26
autoconfig		IN	A	35.212.127.26
ssh			IN	A	35.212.127.26
mail			IN	A	35.212.127.26
ftp			IN	A	35.212.127.26

; ── mail (Proton, Switzerland) ──────────────────────────────────────────────
@			IN	MX	10 mail.protonmail.ch.
@			IN	MX	20 mailsec.protonmail.ch.
@			IN	TXT	"v=spf1 include:_spf.protonmail.ch ~all"
protonmail._domainkey	IN	CNAME	protonmail.domainkey.dauvbe7zslpx3ezj5w6ua4tyrnsohfb5wismii4jinod4pmg2qydq.domains.proton.ch.
protonmail2._domainkey	IN	CNAME	protonmail2.domainkey.dauvbe7zslpx3ezj5w6ua4tyrnsohfb5wismii4jinod4pmg2qydq.domains.proton.ch.
protonmail3._domainkey	IN	CNAME	protonmail3.domainkey.dauvbe7zslpx3ezj5w6ua4tyrnsohfb5wismii4jinod4pmg2qydq.domains.proton.ch.
_dmarc			IN	TXT	"v=DMARC1; p=quarantine"

; ── verification rows (keep — each proves this domain is ours to someone) ──
@			IN	TXT	"protonmail-verification=85a4bc4cfd48f51a1fd84d6348f50d4dce361cdc"
verify-grah5m087yfpuouh3ov7wgnx.john	IN	TXT	"5dd4878fb7da93428b7eefcbe4dbb3bdcea8a945249da61b9894e6e64e2fb1e"
