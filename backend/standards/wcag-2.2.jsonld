              "identifier": "2.2.3",
              "name": "No Timing",
              "level": "AAA",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/no-timing.html"
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#interruptions",
