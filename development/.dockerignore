# Keep the build context small — the Dockerfile copies only:
#   vendor/software-agent-sdk/**        vendor/automation/**
#   OpenHands-main/tools/canvas_ui_tool.py
#   OpenHands-main/scripts/**           OpenHands-main/build/**
#   canvas/**
# Everything heavy or irrelevant never reaches the builder.

**/node_modules
**/.git
**/.venv
**/__pycache__
**/*.egg-info
**/.next
**/.cache
**/.DS_Store
**/*.pyc
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
canvas/deploy
canvas/.dockerignore
OpenHands-main/test-results
OpenHands-main/playwright-report
OpenHands-main/coverage
OpenHands-main/dist
