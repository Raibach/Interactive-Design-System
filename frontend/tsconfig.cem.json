{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/components/lit/**/*.ts"
  ],
  "exclude": [
    "dist/**",
    "node_modules/**",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/storybook/**",
    "src/components/_old/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}