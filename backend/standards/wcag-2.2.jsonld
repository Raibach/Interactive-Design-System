              "@type": "SuccessCriterion",
              "identifier": "1.4.2",
              "name": "Audio Control",
              "level": "A",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/audio-control.html"
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#contrast-minimum",
              "@type": "SuccessCriterion",
              "identifier": "1.4.3",
              "name": "Contrast (Minimum)",
              "level": "AA",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html"
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#resize-text",
