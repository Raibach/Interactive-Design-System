              "identifier": "1.4.5",
              "name": "Images of Text",
              "level": "AA",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/images-of-text.html"
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#contrast-enhanced",
              "@type": "SuccessCriterion",
              "identifier": "1.4.6",
              "name": "Contrast (Enhanced)",
              "level": "AAA",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-enhanced.html"
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#low-or-no-background-audio",
              "@type": "SuccessCriterion",
              "identifier": "1.4.7",
              "name": "Low or No Background Audio",
              "level": "AAA",
