              "identifier": "2.2.4",
              "name": "Interruptions",
              "level": "AAA",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/interruptions.html"
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#re-authenticating",
              "@type": "SuccessCriterion",
              "identifier": "2.2.5",
              "name": "Re-authenticating",
              "level": "AAA",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/re-authenticating.html"
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#timeouts",
              "@type": "SuccessCriterion",
              "identifier": "2.2.6",
              "name": "Timeouts",
              "level": "AAA",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/timeouts.html"
            }
          ]
        },
        {
          "@id": "https://www.w3.org/TR/WCAG22/#seizures-and-physical-reactions",
          "@type": "Guideline",
          "identifier": "2.3",
          "name": "Seizures and Physical Reactions",
          "description": "Do not design content in a way that is known to cause seizures or physical reactions.",
